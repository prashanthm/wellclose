# ---- profile: laptop (Brief §16.5) ----
WC_DATABASE_URL=postgresql+psycopg://wellclose:wellclose@localhost:5432/wellclose
WC_MINIO_ENDPOINT=localhost:9000
WC_MINIO_ACCESS_KEY=wellclose
WC_MINIO_SECRET_KEY=wellclose-secret
WC_MINIO_SECURE=false
WC_BUCKET_RAW=wc-raw
WC_BUCKET_DERIVED=wc-derived
# LiteLLM gateway (routes to Ollama; ADR-004/§11)
WC_LLM_BASE_URL=http://localhost:4000/v1
WC_LLM_API_KEY=wellclose-local
WC_MODEL_VISION=qwen-vl            # alias in compose/litellm-config.yaml
WC_MODEL_TEXT=qwen-text
WC_MODEL_SMALL=qwen-small
# Escalation tier (§16.4): none | api  (never enable in sovereign profiles)
WC_ESCALATION_TIER=none
WC_ESCALATION_MODEL=
# Temporal (ADR-001)
WC_TEMPORAL_TARGET=localhost:7233
WC_TEMPORAL_NAMESPACE=default
WC_TASK_QUEUE=wellclose-mvp
# OCR (ADR-003): tesseract | doctr
WC_OCR_ENGINE=tesseract
# Review/HITL
WC_T_AUTO=0.95
WC_REVIEW_OIDC_ISSUER=            # Keycloak issuer URL (blank = auth disabled, pilot dev only)
# Langfuse (self-hosted via compose)
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
